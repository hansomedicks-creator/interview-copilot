INTERVIEW_ENV=development
INTERVIEW_DATABASE_URL=sqlite:///./interview-copilot.db
INTERVIEW_PROVIDER_MODE=mock
INTERVIEW_LLM_BASE_URL=https://api.deepseek.com
INTERVIEW_LLM_API_KEY=
INTERVIEW_LLM_MODEL=deepseek-v4-flash
INTERVIEW_LLM_PLANNING_MODEL=deepseek-v4-pro
INTERVIEW_LLM_TIMEOUT_SECONDS=20
INTERVIEW_LLM_MAX_CONTEXT_CHARS=12000
INTERVIEW_LLM_ALLOW_INSECURE_HTTP=false
INTERVIEW_RETENTION_DAYS=90
INTERVIEW_MAX_RETENTION_DAYS=180
INTERVIEW_REQUIRE_RECORDING_NOTICE=true
INTERVIEW_RECORDING_DIR=./data/recordings
INTERVIEW_MAX_AUDIO_CHUNK_BYTES=65536
INTERVIEW_AUDIO_SAMPLE_RATE=16000
INTERVIEW_AUDIO_CHANNELS=1
INTERVIEW_PIPECAT_ENABLED=true
INTERVIEW_ASR_PROVIDER=disabled
INTERVIEW_ASR_ENGINE_MODEL_TYPE=16k_zh_en_speaker_2.0
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_HOTWORDS=
INTERVIEW_SESSION_SECRET=replace-with-a-long-random-value
INTERVIEW_SESSION_HOURS=12
INTERVIEW_PUBLIC_BASE_URL=http://127.0.0.1:8000
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/feishu/callback
FEISHU_OAUTH_SCOPES=auth:user.id:read
FEISHU_NOTIFICATIONS_ENABLED=false
FEISHU_HR_OPEN_IDS=
FEISHU_ADMIN_OPEN_IDS=
INTERVIEW_KNOWLEDGE_VAULT_DIR=
INTERVIEW_KNOWLEDGE_VAULT_NAME=Interview-Knowledge
