# Local configuration and credentials
.env
.env.*
!.env.example

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# JavaScript build artifacts (reserved for future frontend extraction)
node_modules/
.next/
dist/
build/

# Logs and local runtime state
*.log
*.pid
tmp/
temp/
.tmp/
.pytest-*/
.codex-test-*/
.test-*/
.ui-*/
.diagnostic-*

# Candidate and interview runtime data
backend/data/
data/
recordings/
uploads/
imports/
exports/
candidate-data/
*.wav
*.mp3
*.m4a
*.webm
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Resume / recruiting exports are denied by default. Only explicitly reviewed
# synthetic fixtures under the two allow-listed folders may be committed.
*.pdf
*.docx
*.xlsx
*.xls
*.csv
!backend/tests/fixtures/*.csv
!docs/examples/*.csv

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

