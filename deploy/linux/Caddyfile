# Staged only: enable the proxy service after DNS, real credentials and TLS review.
{
	admin off
}

interview-copilot.ink {
	# Pin the reviewed issuer: do not silently accept another CA's agreement.
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:8000 {
		flush_interval -1
	}
}
