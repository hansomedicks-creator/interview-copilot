# Root-only /etc/interview-copilot/production.env. One KEY=value per line.
# init-env generates the database password and session secret on the server.
INTERVIEW_ENV=production
INTERVIEW_DATABASE_URL=GENERATED_ON_SERVER
INTERVIEW_SESSION_SECRET=GENERATED_ON_SERVER
INTERVIEW_PUBLIC_BASE_URL=https://interview-copilot.ink
FEISHU_REDIRECT_URI=https://interview-copilot.ink/api/v1/auth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OAUTH_SCOPES=auth:user.id:read
FEISHU_ADMIN_OPEN_IDS=
FEISHU_HR_OPEN_IDS=
FEISHU_NOTIFICATIONS_ENABLED=false
INTERVIEW_PROVIDER_MODE=production
INTERVIEW_LLM_BASE_URL=https://api.deepseek.com
INTERVIEW_LLM_API_KEY=
INTERVIEW_LLM_MODEL=deepseek-v4-flash
INTERVIEW_LLM_PLANNING_MODEL=deepseek-v4-pro
INTERVIEW_LLM_TIMEOUT_SECONDS=20
INTERVIEW_LLM_MAX_CONTEXT_CHARS=12000
INTERVIEW_ASR_PROVIDER=tencent
INTERVIEW_ASR_ENGINE_MODEL_TYPE=16k_zh_en_speaker_2.0
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
INTERVIEW_PIPECAT_ENABLED=true
INTERVIEW_RECORDING_DIR=/var/lib/interview-copilot/recordings
INTERVIEW_KNOWLEDGE_VAULT_DIR=/var/lib/interview-copilot/knowledge
INTERVIEW_KNOWLEDGE_VAULT_NAME=Interview-Knowledge
INTERVIEW_REQUIRE_RECORDING_NOTICE=true
INTERVIEW_RETENTION_DAYS=90
INTERVIEW_MAX_RETENTION_DAYS=180
