[Unit]
Description=Interview Copilot HTTPS reverse proxy (enable separately)
After=network-online.target interview-copilot.service
Wants=network-online.target
Requires=interview-copilot.service

[Service]
Type=notify
User=interview-proxy
Group=interview-proxy
Environment=HOME=/var/lib/interview-proxy XDG_DATA_HOME=/var/lib/interview-proxy/data XDG_CONFIG_HOME=/var/lib/interview-proxy/config
ExecStart=/opt/interview-copilot/tools/caddy/2.11.7/caddy run --config /etc/interview-copilot-proxy/Caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=interview-proxy
StateDirectoryMode=0750
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/interview-proxy
MemoryHigh=96M
MemoryMax=160M
LimitNOFILE=4096
UMask=0077

[Install]
WantedBy=multi-user.target
